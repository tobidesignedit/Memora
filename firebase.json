{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "location": "nam5"
  },
  "hosting": {
    "public": "web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|svg|png|jpg|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "remoteconfig": {
    "template": "remote_config.json"
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "MEMORA",
        "supportEmail": "ajileyeoluwatobi1@gmail.com",
        "authorizedRedirectUris": [
          "https://memora-hybrid-ai-2026.firebaseapp.com/__/auth/handler",
          "https://memora-hybrid-ai-2026.web.app/__/auth/handler",
          "http://localhost:5173"
        ]
      }
    }
  }
}
