# Copy to .env and fill with your Firebase Web App config (firebase apps:sdkconfig WEB <APP_ID>)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check: set reCAPTCHA Enterprise/v3 site key for production, or true/UUID for hackathon debug testing
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=true
# VITE_RECAPTCHA_ENTERPRISE_KEY=
